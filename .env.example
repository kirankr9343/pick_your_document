# Pick Your Document — Production Environment Configuration

# Application Metadata
PROJECT_NAME="Pick Your Document"
APP_ENV=production
DEBUG=false

# Security & Storage
SECRET_KEY="YOUR_SUPER_SECRET_KEY_CHANGE_IN_PRODUCTION"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
MAX_FILE_SIZE_MB=50
FILE_EXPIRY_HOURS=2

# Database Connection
DATABASE_URL="sqlite+aiosqlite:///./pick_your_document.db"
# For PostgreSQL in production:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/pick_your_document"

# Google OAuth 2.0 Credentials (Get from Google Cloud Console)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
# Production Redirect URI:
# GOOGLE_REDIRECT_URI="https://yourdomain.com/api/v1/auth/google/callback"

# Rate Limits (Requests per hour)
ANONYMOUS_REQUESTS_PER_HOUR=60
AUTHENTICATED_REQUESTS_PER_HOUR=300

# AI Configuration (pdf-summary)
AI_PROVIDER="heuristic" # Options: openai, gemini, anthropic, heuristic
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# OCR Configuration (image-to-text)
OCR_PROVIDER="tesseract" # Options: tesseract, easyocr, fallback

# Monetization & Analytics
ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXXX"
ANALYTICS_ENABLED=true
ANALYTICS_ID=""

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://kirankr9343.github.io"
