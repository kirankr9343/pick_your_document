# Application Environment
APP_ENV=development
DEBUG=True

# Security
SECRET_KEY=SUPER_SECRET_PRODUCTION_KEY_PICK_YOUR_DOCUMENT_2026_CHANGE_ME
MAX_FILE_SIZE_MB=50
FILE_EXPIRY_HOURS=2

# Database (PostgreSQL in production, SQLite auto-fallback in dev)
DATABASE_URL=postgresql://postgres:postgres_password@db:5432/pick_your_document

# Rate Limiting
ANONYMOUS_REQUESTS_PER_HOUR=60
AUTHENTICATED_REQUESTS_PER_HOUR=300

# OCR Provider Configuration (tesseract / easyocr / fallback)
OCR_PROVIDER=tesseract

# AI Provider Configuration (openai / gemini / anthropic / heuristic)
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Advertisement (Google AdSense) Toggle
ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID=

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_ID=

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
